# Build / packaging
/build
/dist
/pycaret.egg-info
/pycaret_nightly.egg-info

# Python
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual envs
venv/
/.venv*
/.devcontainer

# Logs (root + anywhere in the tree)
*.log
logs.log
/docs/build

# Runtime artifacts (notebook / experiment outputs)
artifacts/
trained_models/
catboost_info/
*.pkl

# Legacy (kept from 3.x — ignore if accidentally recreated)
mlruns/
/mlruns.db
/mlruns.db-journal
mlflow_backend.py
dask*/

# ─── SQLite / databases (anywhere in the tree) ─────────────────────────
# Session 56: broadened from the specific `/pycaret.db` rule to cover
# pycaret-dev.db, smoke.db, test_phase_smoke.db, and any *.sqlite a
# contributor's dev env might create. NEVER commit local DB state — it
# may contain Fernet-encrypted secret blobs (LLM keys, connection
# credentials). The encryption is good, but defense in depth: don't ship
# the encrypted blobs either.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# ─── Environment / secrets files ───────────────────────────────────────
# Catch any .env anywhere in the tree. .env.example is the documented
# template (no values) and IS committed.
.env
.env.*
!.env.example
!.env.*.example

# Auth / credential dumps we never want to see in git.
*.pem
*.key
!packages/engine/pycaret/**/*.pem
!packages/engine/pycaret/**/*.key
credentials.json
service-account*.json
aws-credentials*
.aws/

# Local docker-compose data volume (api container persists SQLite + artifacts).
/data/

# IDE / editor
.vscode/settings.json
*code-workspace
.idea/
.DS_Store

# Scratch / temp
tmp/
nbtest*.ipynb
demo*.py
.tmp-*
# Catch ad-hoc debugging scripts that tend to accumulate at the root.
# Tests live under packages/engine/tests/ or services/api/tests/; anything
# else at the root is almost certainly scratch.
/trace.py
/scratch.py
/scratch_*.py
/repro.py
/repro_*.py
/debug.py
/debug_*.py
