# Files allowed to contain strings that LOOK like secrets but aren't.
# One path per line, glob patterns OK. See scripts/check-secrets.sh.

# Test fixtures use obviously-fake strings.
services/api/tests/**

# The check script itself contains every pattern it's looking for.
scripts/check-secrets.sh

# Example env file — documents the variable names but holds no values.
.env.example

# Notebooks may have cell outputs that mention old keys (we scrub these
# at notebook publish-time via scripts/build_notebooks.py — but during
# active dev a notebook can carry stale strings).
notebooks/**
