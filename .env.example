# PyCaret Control Plane — environment template
#
# Copy to .env, fill in the values you actually need, leave the rest commented.
# The .env file is GIT-IGNORED. Never commit real secrets.
#
# Defaults shown below are what you get with `docker compose up` out of the
# box. Override only what's different in your environment.

# ─── Secrets ─────────────────────────────────────────────────────────────
# Fernet key (base64-urlsafe 32 bytes) used to encrypt LLM API keys,
# datasource passwords, etc. at rest. If left blank, the api container
# auto-generates one on first start and persists it to the data volume
# (entrypoint.sh handles this). Set explicitly only if you want the same
# key across multiple instances (multi-replica setup, blue/green, etc.).
#
# To generate a key manually:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#PYCARET_SECRETS_KEY=

# JWT secret — used to sign access + refresh tokens. CHANGE THIS in prod.
# Treat losing/leaking it the same as losing every user's password.
PYCARET_JWT_SECRET=dev-only-jwt-secret-do-not-use-in-prod

# ─── Database ────────────────────────────────────────────────────────────
# Default: SQLite at /data/pycaret.db (persisted to the data volume).
# Switch to Postgres for prod by setting a postgresql:// URL.
#PYCARET_DATABASE_URL=sqlite:////data/pycaret.db
#PYCARET_DATABASE_URL=postgresql+psycopg://user:password@host:5432/pycaret

# ─── Object storage ──────────────────────────────────────────────────────
# Default: local filesystem under /data/artifacts.
# Switch to S3 in prod by setting the bucket + credentials below.
#PYCARET_STORAGE_BACKEND=local
#PYCARET_STORAGE_BACKEND=s3
#PYCARET_STORAGE_BUCKET=my-pycaret-artifacts
#PYCARET_STORAGE_REGION=us-east-1
#PYCARET_STORAGE_ACCESS_KEY=
#PYCARET_STORAGE_SECRET_KEY=
# For MinIO / S3-compatible endpoints:
#PYCARET_STORAGE_ENDPOINT_URL=http://minio:9000

# ─── CORS ────────────────────────────────────────────────────────────────
# JSON-array string. Default covers the docker-compose UI on :3020.
#PYCARET_CORS_ORIGINS=["http://localhost:3020","http://127.0.0.1:3020"]

# ─── Runtime behaviour ───────────────────────────────────────────────────
#PYCARET_ENVIRONMENT=dev          # dev | staging | prod
#PYCARET_DEBUG=false

# ─── Email (SMTP) — alerting + invites ──────────────────────────────────
# Leave blank to disable email; the platform still works for everything
# else, just no "you've been invited" emails. SES, Mailgun, etc. work via
# their SMTP gateways.
#PYCARET_SMTP_HOST=smtp.example.com
#PYCARET_SMTP_PORT=587
#PYCARET_SMTP_USERNAME=
#PYCARET_SMTP_PASSWORD=
#PYCARET_SMTP_USE_TLS=true
#PYCARET_SMTP_FROM=pycaret@example.com
